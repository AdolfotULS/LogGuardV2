                                                </Border>
                                                <Border Height="1" Width="20" Background="{StaticResource Line2Brush}" VerticalAlignment="Center"/>
                                                <Border Width="26" Height="26" BorderBrush="{StaticResource DangerBrush}" BorderThickness="2" Background="#1AE5484D" CornerRadius="13">
                                                    <TextBlock Text="q₃" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                        <UniformGrid Columns="3" Margin="0,0,0,10">
                                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,1" Padding="0,10">
                                                <StackPanel><TextBlock Text="STATES" FontFamily="Segoe UI" FontSize="9" Foreground="{StaticResource TextMuteBrush}"/>
                                                    <TextBlock Text="4" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/></StackPanel>
                                            </Border>
                                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,1" Padding="0,10">
                                                <StackPanel><TextBlock Text="HITS 15M" FontFamily="Segoe UI" FontSize="9" Foreground="{StaticResource TextMuteBrush}"/>
                                                    <TextBlock Text="0" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/></StackPanel>
                                            </Border>
                                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,1" Padding="0,10">
                                                <StackPanel><TextBlock Text="MATCH RATE" FontFamily="Segoe UI" FontSize="9" Foreground="{StaticResource TextMuteBrush}"/>
                                                    <TextBlock Text="—" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/></StackPanel>
                                            </Border>
                                        </UniformGrid>
                                        <DockPanel>
                                            <Border Background="{StaticResource Bg3}" BorderBrush="{StaticResource Line2Brush}" BorderThickness="1" Padding="8,3" Margin="0,0,6,0">
                                                <TextBlock Text="entry: q₀" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
                                            </Border>
                                            <Border Background="{StaticResource Bg3}" BorderBrush="{StaticResource Line2Brush}" BorderThickness="1" Padding="8,3">
                                                <TextBlock Text="accept: q₃" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
                                            </Border>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Height="26" FontSize="11">Reload JSON</Button>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Import button -->
                                <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="1.5"
                                        Background="Transparent" Margin="0,0,0,14" MinHeight="80">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M12 5 L12 19 M5 12 L19 12"
                                                  Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.8"
                                                  Fill="Transparent" Width="14" Height="14" Margin="0,0,8,0"/>
                                            <TextBlock Text="Import New Module (.json)"
                                                       FontSize="13" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </UniformGrid>
                        </ScrollViewer>
                    </Grid>

                    <!-- ══════════════════════════════
                         TAB: SETTINGS
                    ══════════════════════════════ -->
                    <Grid x:Name="TabSettings" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource Bg1}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                            <DockPanel Margin="14,0" LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="System Settings" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text=" / configuration" FontSize="12" Foreground="{StaticResource TextMuteBrush}" Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnDiscardSettings" Style="{StaticResource BtnGhost}" Margin="0,0,6,0" Click="BtnDiscardSettings_Click">Discard</Button>
                                    <Button x:Name="BtnSaveSettings" Style="{StaticResource BtnAccent}" Click="BtnSaveSettings_Click">Save changes</Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="980" HorizontalAlignment="Center" Margin="16" Width="auto">

                                <!-- Source & Watch card -->
                                <Border Background="{StaticResource Bg2}" BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Source &amp; Watch" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="Location of PostgreSQL log files. LogGuard tails these in real time."
                                                   FontSize="11" Foreground="{StaticResource TextMuteBrush}" Margin="0,0,0,12"/>
                                        <!-- Log dir field -->
                                        <TextBlock Text="LOG DIRECTORY PATH" FontFamily="Segoe UI" FontSize="10"
                                                   Foreground="{StaticResource TextMuteBrush}" Margin="0,0,0,6"/>
                                        <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="1" Height="32" Margin="0,0,0,4">
                                            <DockPanel Margin="10,0">
                                                <Button x:Name="BtnBrowseLogDir" DockPanel.Dock="Right" Background="Transparent" BorderThickness="0"
                                                        Foreground="{StaticResource TextMuteBrush}" FontSize="12" Cursor="Hand"
                                                        Padding="4,0" Click="BtnBrowseLogDir_Click">Browse…</Button>
                                                <TextBox x:Name="TxtLogDir" Text="C:\ProgramData\LogGuard\watch\" Background="Transparent"
                                                         BorderThickness="0" Foreground="{StaticResource TextBrush}"
                                                         FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"
                                                         CaretBrush="{StaticResource AccentBrush}"/>
                                            </DockPanel>
                                        </Border>
                                        <TextBlock Text="PostgreSQL `log_directory` — default: pg_log"
                                                   FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMuteBrush}" Margin="0,0,0,12"/>
                                        <!-- Pattern field -->
                                        <TextBlock Text="WATCH FILE PATTERN" FontFamily="Segoe UI" FontSize="10"
                                                   Foreground="{StaticResource TextMuteBrush}" Margin="0,0,0,6"/>
                                        <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="1" Height="32" Margin="0,0,0,4">
                                            <DockPanel Margin="10,0">
                                                <Button x:Name="BtnTestPattern" DockPanel.Dock="Right" Background="Transparent" BorderThickness="0"
                                                        Foreground="{StaticResource TextMuteBrush}" FontSize="12" Cursor="Hand" Padding="4,0" Click="BtnTestPattern_Click">Test</Button>
                                                <TextBox x:Name="TxtWatchPattern" Text="postgresql-*.log" Background="Transparent" BorderThickness="0"
                                                         Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="12"
                                                         VerticalAlignment="Center" CaretBrush="{StaticResource AccentBrush}"/>
                                            </DockPanel>
                                        </Border>
                                        <TextBlock Text="Glob pattern · current match: prod-db-cluster-01.audit.log (412 MB)"
                                                   FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMuteBrush}" Margin="0,0,0,12"/>
                                        <!-- Timezone + Format row -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="TIMEZONE" FontFamily="Segoe UI" FontSize="10"
                                                           Foreground="{StaticResource TextMuteBrush}" Margin="0,0,0,6"/>
                                                <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource LineBrush}"
                                                        BorderThickness="1" Height="32" Padding="10,0">
                                                    <TextBox x:Name="TxtTimezone" Text="UTC" Background="Transparent" BorderThickness="0"
                                                             Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="12"
                                                             VerticalAlignment="Center" CaretBrush="{StaticResource AccentBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="LOG LINE FORMAT" FontFamily="Segoe UI" FontSize="10"
                                                           Foreground="{StaticResource TextMuteBrush}" Margin="0,0,0,6"/>
                                                <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource LineBrush}"
                                                        BorderThickness="1" Height="32" Padding="10,0">
                                                    <TextBox x:Name="TxtLogLineFormat" Text="%m [%p] %q%u@%h %d " Background="Transparent" BorderThickness="0"
                                                             Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="12"
                                                             VerticalAlignment="Center" CaretBrush="{StaticResource AccentBrush}"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        <!-- Switches -->
                                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                            <DockPanel>
                                                <ToggleButton x:Name="TogFollowRotation" DockPanel.Dock="Right" Style="{StaticResource ToggleStyle}" IsChecked="True"/>
                                                <StackPanel>
                                                    <TextBlock Text="Follow rotation" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                                                    <TextBlock Text="Automatically reattach when the log file is rotated"
                                                               FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMuteBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <Border Padding="0,8">
                                            <DockPanel>
                                                <ToggleButton x:Name="TogReplayOnStart" DockPanel.Dock="Right" Style="{StaticResource ToggleStyle}" IsChecked="False"/>
                                                <StackPanel>
                                                    <TextBlock Text="Replay historical entries on start" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                                                    <TextBlock Text="Parse existing lines from the last rotation before tailing"
                                                               FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMuteBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Parser card -->
                                <Border Background="{StaticResource Bg2}" BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Parser · PostgresLogEntry" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="Fields extracted per log line. Disable fields to reduce memory."
                                                   FontSize="11" Foreground="{StaticResource TextMuteBrush}" Margin="0,0,0,12"/>
                                        <UniformGrid Columns="3" Margin="0,0,0,4">
                                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                                <DockPanel><ToggleButton x:Name="TogCoreFields" DockPanel.Dock="Right" Style="{StaticResource ToggleStyle}" IsChecked="True"/>
                                                    <StackPanel><TextBlock Text="Timestamp · Timezone · PID · Level" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                                                        <TextBlock Text="core fields · required" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMuteBrush}" Margin="0,2,0,0"/></StackPanel></DockPanel>
                                            </Border>
                                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="8,8">
                                                <DockPanel><ToggleButton x:Name="TogConnectionDetails" DockPanel.Dock="Right" Style="{StaticResource ToggleStyle}" IsChecked="True"/>
                                                    <StackPanel><TextBlock Text="ConnectionDetails" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                                                        <TextBlock Text="host, port, user, database, appName" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMuteBrush}" Margin="0,2,0,0"/></StackPanel></DockPanel>
                                            </Border>
                                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="8,8">
                                                <DockPanel><ToggleButton x:Name="TogQueryDetails" DockPanel.Dock="Right" Style="{StaticResource ToggleStyle}" IsChecked="True"/>
                                                    <StackPanel><TextBlock Text="QueryDetails" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                                                        <TextBlock Text="content, durationMs, isInjected" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMuteBrush}" Margin="0,2,0,0"/></StackPanel></DockPanel>
                                            </Border>
                                            <Border Padding="0,8">
                                                <DockPanel><ToggleButton x:Name="TogSystemMetrics" DockPanel.Dock="Right" Style="{StaticResource ToggleStyle}" IsChecked="False"/>
                                                    <StackPanel><TextBlock Text="SystemMetrics" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                                                        <TextBlock Text="buffers, lsn, recoveryMode" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMuteBrush}" Margin="0,2,0,0"/></StackPanel></DockPanel>
                                            </Border>
                                            <Border Padding="8,8">
                                                <DockPanel><ToggleButton x:Name="TogRawMessage" DockPanel.Dock="Right" Style="{StaticResource ToggleStyle}" IsChecked="True"/>
                                                    <StackPanel><TextBlock Text="RawMessage" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                                                        <TextBlock Text="keep the original log line for forensics" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMuteBrush}" Margin="0,2,0,0"/></StackPanel></DockPanel>
                                            </Border>
                                            <Border Padding="8,8">
                                                <DockPanel><ToggleButton x:Name="TogRedactPasswords" DockPanel.Dock="Right" Style="{StaticResource ToggleStyle}" IsChecked="True"/>
                                                    <StackPanel><TextBlock Text="Redact passwords in RawMessage" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                                                        <TextBlock Text="masks `password '…'` tokens" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMuteBrush}" Margin="0,2,0,0"/></StackPanel></DockPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- Alerts card -->
                                <Border Background="{StaticResource Bg2}" BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Alerts" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="160"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="WEBHOOK URL" FontFamily="Segoe UI" FontSize="10"
                                                           Foreground="{StaticResource TextMuteBrush}" Margin="0,0,0,6"/>
                                                <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource LineBrush}"
                                                        BorderThickness="1" Height="32" Padding="10,0">
                                                    <TextBox x:Name="TxtWebhookUrl" Text="https://hooks.internal/logguard/alerts" Background="Transparent"
                                                             BorderThickness="0" Foreground="{StaticResource TextBrush}"
                                                             FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"
                                                             CaretBrush="{StaticResource AccentBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="MINIMUM LEVEL" FontFamily="Segoe UI" FontSize="10"
                                                           Foreground="{StaticResource TextMuteBrush}" Margin="0,0,0,6"/>
                                                <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource LineBrush}"
                                                        BorderThickness="1" Height="32" Padding="10,0">
                                                    <TextBox x:Name="TxtMinLevel" Text="ERROR" Background="Transparent" BorderThickness="0"
                                                             Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="12"
                                                             VerticalAlignment="Center" CaretBrush="{StaticResource AccentBrush}"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                            <DockPanel>
                                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleStyle}" IsChecked="True"/>
                                                <StackPanel>
                                                    <TextBlock Text="Desktop notifications" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                                                    <TextBlock Text="toast on NFA accept state" FontFamily="Consolas" FontSize="10"
                                                               Foreground="{StaticResource TextMuteBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <Border Padding="0,8">
                                            <DockPanel>
                                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleStyle}" IsChecked="False"/>
                                                <StackPanel>
                                                    <TextBlock Text="Audio beep on FATAL" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                                                    <TextBlock Text="single 120 ms tone" FontFamily="Consolas" FontSize="10"
                                                               Foreground="{StaticResource TextMuteBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </Grid>

            <!-- ═══════════════════════════════════════════════
                 STATUS BAR
            ═══════════════════════════════════════════════ -->
            <Border Grid.Row="2" Background="{StaticResource Bg0}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <DockPanel Margin="12,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="v2.4.1 · build 8821 │ " FontFamily="Consolas" FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}"/>
                        <TextBlock x:Name="ClockText" FontFamily="Consolas" FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource OkBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="LIVE · watching 1 file │ events: 4,812,204 │ dropped: 0 │ lag: 12ms"
                                   FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

        </Grid>
    </Border>
</Window>
