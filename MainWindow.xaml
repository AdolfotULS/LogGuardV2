<Window x:Class="LogGuardV2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LogGuardV2"
        Title="LogGuard — Real-Time Threat Analyzer"
        Width="1440" Height="900"
        MinWidth="900" MinHeight="600"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource Bg1}">

    <Window.Resources>
        <local:LevelToSevColorConverter   x:Key="LevelToSevColor"/>
        <local:LevelToBadgeFgConverter    x:Key="LevelBadgeFg"/>
        <local:LevelToBadgeBgConverter    x:Key="LevelBadgeBg"/>
        <local:LevelToBadgeBorderConverter x:Key="LevelBadgeBorder"/>
        <local:BoolToInjTextConverter     x:Key="InjText"/>
        <local:BoolToInjFgConverter       x:Key="InjFg"/>
        <local:BoolToInjBgConverter       x:Key="InjBg"/>
        <local:BoolToInjBorderConverter   x:Key="InjBorder"/>
        <local:DurFmtConverter            x:Key="DurFmt"/>
    </Window.Resources>

    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="26"/>
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════
                 TITLE BAR
            ═══════════════════════════════════════════════ -->
            <Border Grid.Row="0"
                    Background="{StaticResource Bg0}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <DockPanel LastChildFill="False">
                    <!-- Brand -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="12,0" IsHitTestVisible="False">
                        <Border Width="14" Height="14"
                                BorderBrush="{StaticResource OkBrush}" BorderThickness="1.5"
                                Margin="0,0,8,0">
                            <Border Background="{StaticResource OkBrush}" Margin="3"/>
                        </Border>
                        <TextBlock Text="LogGuard" FontWeight="SemiBold" FontSize="12"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text=" — Real-Time Threat Analyzer" FontSize="12"
                                   Foreground="{StaticResource TextMuteBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Window buttons -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource WinBtn}" Click="BtnMinimize_Click">
                            <Path Data="M0,0 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2"/>
                        </Button>
                        <Button Style="{StaticResource WinBtn}" Click="BtnMaximize_Click">
                            <Rectangle Width="9" Height="9"
                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       StrokeThickness="1.2" Fill="Transparent"/>
                        </Button>
                        <Button Style="{StaticResource WinBtnClose}" Click="BtnClose_Click">
                            <Grid Width="10" Height="10">
                                <Path Data="M0,0 L10,10"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.2"/>
                                <Path Data="M10,0 L0,10"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.2"/>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Status pill -->
                    <Border DockPanel.Dock="Right"
                            Background="{StaticResource Bg3}" BorderBrush="{StaticResource Line2Brush}"
                            BorderThickness="1" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource OkBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="MONITORING · session #4A9C"
                                       FontFamily="Consolas" FontSize="10"
                                       Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════
                 MAIN AREA
            ═══════════════════════════════════════════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Border Grid.Column="0"
                        Background="{StaticResource Bg0}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="0,0,1,0">
                    <StackPanel Margin="8,10" HorizontalAlignment="Center">
                        <!-- Dashboard -->
                        <Button x:Name="NavDashboard" Style="{StaticResource NavBtn}"
                                Click="NavDashboard_Click" ToolTip="Dashboard" Margin="0,2">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Rectangle Canvas.Left="3" Canvas.Top="3" Width="7" Height="9"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               StrokeThickness="1.8" Fill="Transparent"/>
                                    <Rectangle Canvas.Left="14" Canvas.Top="3" Width="7" Height="5"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               StrokeThickness="1.8" Fill="Transparent"/>
                                    <Rectangle Canvas.Left="14" Canvas.Top="12" Width="7" Height="9"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               StrokeThickness="1.8" Fill="Transparent"/>
                                    <Rectangle Canvas.Left="3" Canvas.Top="16" Width="7" Height="5"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               StrokeThickness="1.8" Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <!-- Monitor (active by default) -->
                        <Button x:Name="NavMonitor" Style="{StaticResource NavBtnActive}"
                                Click="NavMonitor_Click" ToolTip="Threat Monitor" Margin="0,2">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Polyline Points="3,12 7,12 10,5 14,19 17,12 21,12"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.8" Fill="Transparent"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <!-- Modules -->
                        <Button x:Name="NavModules" Style="{StaticResource NavBtn}"
                                Click="NavModules_Click" ToolTip="Module Manager" Margin="0,2">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Rectangle Canvas.Left="3" Canvas.Top="3" Width="8" Height="8"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               StrokeThickness="1.8" Fill="Transparent"/>
                                    <Rectangle Canvas.Left="13" Canvas.Top="3" Width="8" Height="8"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               StrokeThickness="1.8" Fill="Transparent"/>
                                    <Rectangle Canvas.Left="3" Canvas.Top="13" Width="8" Height="8"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               StrokeThickness="1.8" Fill="Transparent"/>
                                    <Rectangle Canvas.Left="13" Canvas.Top="13" Width="8" Height="8"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               StrokeThickness="1.8" Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <!-- Settings -->
                        <Button x:Name="NavSettings" Style="{StaticResource NavBtn}"
                                Click="NavSettings_Click" ToolTip="System Settings" Margin="0,2">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Ellipse Canvas.Left="9" Canvas.Top="9" Width="6" Height="6"
                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                             StrokeThickness="1.8" Fill="Transparent"/>
                                    <Path Data="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- CONTENT AREA — all tabs overlaid, toggled by Visibility -->
                <Grid Grid.Column="1">

                    <!-- ══════════════════════════════
                         TAB: THREAT MONITOR (default)
                    ══════════════════════════════ -->
                    <Grid x:Name="TabMonitor" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Tab header -->
                        <Border Grid.Row="0" Background="{StaticResource Bg1}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                            <DockPanel Margin="14,0" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="Threat Monitor"
                                           FontWeight="SemiBold" FontSize="13"
                                           Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{StaticResource Bg3}"
                                            BorderBrush="{StaticResource Line2Brush}" BorderThickness="1"
                                            Padding="8,3" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource OkBrush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="3 / 3 MODULES ACTIVE" FontFamily="Consolas" FontSize="10"
                                                       Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Style="{StaticResource BtnPrimary}" Height="28" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M8,5 L8,19 L19,12 Z"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Margin="0,0,6,0"/>
                                            <TextBlock Text="Start" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource BtnDanger}" Height="28">
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="10" Height="10"
                                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                       Margin="0,0,6,0"/>
                                            <TextBlock Text="Stop" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- KPI bar -->
                        <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                            <UniformGrid Columns="5">
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="EVENTS / SEC" FontFamily="Segoe UI" FontSize="10"
                                                   Foreground="{StaticResource TextMuteBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="1,284" FontFamily="Consolas" FontSize="20" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="▾ 3.1% vs 5m avg" FontSize="11" Foreground="{StaticResource OkBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="FATAL / ERROR" FontFamily="Segoe UI" FontSize="10"
                                                   Foreground="{StaticResource TextMuteBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="17" FontFamily="Consolas" FontSize="20" FontWeight="SemiBold"
                                                   Foreground="{StaticResource DangerBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="▴ 4 in last minute" FontSize="11" Foreground="{StaticResource WarnBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="INJECTED QUERIES" FontFamily="Segoe UI" FontSize="10"
                                                   Foreground="{StaticResource TextMuteBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="9" FontFamily="Consolas" FontSize="20" FontWeight="SemiBold"
                                                   Foreground="{StaticResource WarnBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="last 15m" FontSize="11" Foreground="{StaticResource TextMuteBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="AVG DURATION" FontFamily="Segoe UI" FontSize="10"
                                                   Foreground="{StaticResource TextMuteBrush}" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="42.8 " FontFamily="Consolas" FontSize="20" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="ms" FontFamily="Consolas" FontSize="13"
                                                       Foreground="{StaticResource TextMuteBrush}"
                                                       VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                        </StackPanel>
                                        <TextBlock Text="p95 280ms" FontSize="11" Foreground="{StaticResource TextMuteBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="UPTIME" FontFamily="Segoe UI" FontSize="10"
                                                   Foreground="{StaticResource TextMuteBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="04:12:38" FontFamily="Consolas" FontSize="20" FontWeight="SemiBold"
                                                   Foreground="{StaticResource OkBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="since 09:14 UTC" FontSize="11" Foreground="{StaticResource TextMuteBrush}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Border>

                        <!-- Filter bar -->
                        <Border Grid.Row="2" Background="{StaticResource Bg1}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                            <WrapPanel Margin="14,8" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{StaticResource Bg2}" BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1" Height="28" Width="420" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                        <Path Data="M21,21 L16.65,16.65 M11,18 A7,7 0 1,0 11,4 A7,7 0 1,0 11,18"
                                              Stroke="{StaticResource TextMuteBrush}" StrokeThickness="1.8"
                                              Fill="Transparent" Width="12" Height="12" Margin="0,0,8,0"/>
                                        <TextBox Text="database:orders_prod AND level&gt;=WARNING"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{StaticResource TextBrush}"
                                                 FontFamily="Consolas" FontSize="12"
                                                 VerticalAlignment="Center" Width="360" CaretBrush="{StaticResource AccentBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#140A0A" BorderBrush="{StaticResource DangerBrush}"
                                        BorderThickness="1" Padding="9,4" Height="28" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource DangerBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="FATAL" FontSize="11" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#140A0A" BorderBrush="{StaticResource DangerBrush}"
                                        BorderThickness="1" Padding="9,4" Height="28" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource DangerBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="ERROR" FontSize="11" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#14100A" BorderBrush="{StaticResource WarnBrush}"
                                        BorderThickness="1" Padding="9,4" Height="28" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource WarnBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="WARNING" FontSize="11" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource Bg2}" BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1" Padding="9,4" Height="28" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource InfoBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="NOTICE" FontSize="11" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource Bg2}" BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1" Padding="9,4" Height="28" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource TextMuteBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="LOG" FontSize="11" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource Bg3}" BorderBrush="{StaticResource Line2Brush}"
                                        BorderThickness="1" Padding="8,3" Height="28" Margin="0,0,4,0">
                                    <TextBlock Text="LAST 15 MIN ▾" FontFamily="Consolas" FontSize="10"
                                               Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="{StaticResource Bg3}" BorderBrush="{StaticResource Line2Brush}"
                                        BorderThickness="1" Padding="8,3" Height="28">
                                    <TextBlock Text="LIVE TAIL ▾" FontFamily="Consolas" FontSize="10"
                                               Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                                </Border>
                            </WrapPanel>
                        </Border>

                        <!-- Log DataGrid -->
                        <DataGrid Grid.Row="3" x:Name="LogGrid">
                            <DataGrid.Columns>
                                <!-- Severity stripe -->
                                <DataGridTemplateColumn Width="24" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Rectangle Width="2" HorizontalAlignment="Left"
                                                       Fill="{Binding Level, Converter={StaticResource LevelToSevColor}}"
                                                       VerticalAlignment="Stretch"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="TIMESTAMP"  Width="185" Binding="{Binding Timestamp}"
                                                   ElementStyle="{StaticResource CellTextDim}"/>
                                <DataGridTextColumn Header="PID"        Width="60"  Binding="{Binding Pid}"
                                                   ElementStyle="{StaticResource CellTextMute}"/>
                                <!-- Level badge -->
                                <DataGridTemplateColumn Header="LEVEL"  Width="75">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Level, Converter={StaticResource LevelBadgeBg}}"
                                                    BorderBrush="{Binding Level, Converter={StaticResource LevelBadgeBorder}}"
                                                    BorderThickness="1" Padding="6,1"
                                                    HorizontalAlignment="Left" Margin="10,0">
                                                <TextBlock Text="{Binding Level}"
                                                           Foreground="{Binding Level, Converter={StaticResource LevelBadgeFg}}"
                                                           FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="USER @ HOST" Width="155" Binding="{Binding UserHost}"
                                                   ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="DATABASE"   Width="130" Binding="{Binding Database}"
                                                   ElementStyle="{StaticResource CellTextDim}"/>
                                <DataGridTextColumn Header="QUERY"      Width="*"   Binding="{Binding Query}"
                                                   ElementStyle="{StaticResource CellText}"/>
                                <!-- Duration -->
                                <DataGridTemplateColumn Header="DUR (MS)" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Duration, Converter={StaticResource DurFmt}}"
                                                       Foreground="{StaticResource TextDimBrush}"
                                                       FontFamily="Consolas" FontSize="12"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Margin="0,0,10,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Injected badge -->
                                <DataGridTemplateColumn Header="INJECTED" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding IsInjected, Converter={StaticResource InjBg}}"
                                                    BorderBrush="{Binding IsInjected, Converter={StaticResource InjBorder}}"
                                                    BorderThickness="1" Padding="6,1"
                                                    HorizontalAlignment="Left" Margin="10,0">
                                                <TextBlock Text="{Binding IsInjected, Converter={StaticResource InjText}}"
                                                           Foreground="{Binding IsInjected, Converter={StaticResource InjFg}}"
                                                           FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- ══════════════════════════════
                         TAB: DASHBOARD
                    ══════════════════════════════ -->
                    <Grid x:Name="TabDashboard" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Background="{StaticResource Bg1}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                            <DockPanel Margin="14,0" LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Dashboard" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text=" / telemetry &amp; health" FontSize="12"
                                               Foreground="{StaticResource TextMuteBrush}" Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{StaticResource Bg3}" BorderBrush="{StaticResource Line2Brush}"
                                            BorderThickness="1" Padding="8,3" Margin="0,0,6,0">
                                        <TextBlock Text="RANGE: LAST 1H ▾" FontFamily="Consolas" FontSize="10"
                                                   Foreground="{StaticResource TextDimBrush}"/>
                                    </Border>
                                    <Border Background="{StaticResource Bg3}" BorderBrush="{StaticResource Line2Brush}"
                                            BorderThickness="1" Padding="8,3">
                                        <TextBlock Text="REFRESH 5s ▾" FontFamily="Consolas" FontSize="10"
                                                   Foreground="{StaticResource TextDimBrush}"/>
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Dashboard panels -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16" >
                                <!-- Row 1: 4 KPI sparkline panels -->
                                <UniformGrid Columns="4" Margin="0,0,0,16">
                                    <!-- QPS -->
                                    <Border Background="{StaticResource Bg2}" BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1" Padding="14" Margin="0,0,8,0">
                                        <StackPanel>
                                            <DockPanel><TextBlock Text="Queries / sec" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock DockPanel.Dock="Right" Text="QPS" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMuteBrush}" VerticalAlignment="Center"/></DockPanel>
                                            <TextBlock Text="1,284" FontFamily="Consolas" FontSize="26" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}" Margin="0,8,0,4"/>
                                            <Canvas x:Name="SparkQps" Height="60" Width="300" ClipToBounds="True"/>
                                            <TextBlock Text="peak 1,902 · avg 1,110" FontFamily="Consolas" FontSize="11"
                                                       Foreground="{StaticResource TextMuteBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Memory -->
                                    <Border Background="{StaticResource Bg2}" BorderBrush="{StaticResource LineBrush}"
