{
  "profileId": "pgsql-sqli-v1",
  "name": "SQL Injection - Tautology and Union",
  "version": "1.3.0",
  "enabled": true,
  "threatType": "SQLI",
  "target": {
    "source": "PostgreSQL",
    "inputField": "Query",
    "tokenizer": "SqlTokenizer"
  },
  "alphabet": [
    "SELECT", "FROM", "WHERE", "IDENT", "STAR", "EQUALS", 
    "STRING", "OR", "UNION", "TAUTOLOGY"
  ],
  "states": [
    { "id": "q0",       "isStart": true,  "isAccept": false },
    { "id": "q_prefix", "isStart": false, "isAccept": false },
    { "id": "q_where",  "isStart": false, "isAccept": false },
    { "id": "q_val",    "isStart": false, "isAccept": false },
    { "id": "q_sqli",   "isStart": false, "isAccept": true  }
  ],
  "transitions": [
    { "from": "q0",       "symbol": "SELECT",    "to": "q_prefix" },
    { "from": "q_prefix", "symbol": "IDENT",     "to": "q_prefix" },
    { "from": "q_prefix", "symbol": "STAR",      "to": "q_prefix" },
    { "from": "q_prefix", "symbol": "FROM",      "to": "q_prefix" },
    { "from": "q_prefix", "symbol": "WHERE",     "to": "q_where"  },
    
    { "from": "q_where",  "symbol": "IDENT",     "to": "q_where"  },
    { "from": "q_where",  "symbol": "EQUALS",    "to": "q_where"  },
    { "from": "q_where",  "symbol": "STRING",    "to": "q_val"    },
    
    { "from": "q_val",    "symbol": "OR",        "to": "q_sqli"   },
    { "from": "q_val",    "symbol": "TAUTOLOGY", "to": "q_sqli"   },
    { "from": "q_val",    "symbol": "UNION",     "to": "q_sqli"   },
    { "from": "q_sqli",   "symbol": "SELECT",    "to": "q_sqli"   },
    { "from": "q_sqli",   "symbol": "TAUTOLOGY", "to": "q_sqli"   }
  ],
  "metadata": {
    "severity": "High",
    "description": "Detecta inyecciones SQL que ocurren después de una cláusula WHERE estándar",
    "tags": [ "sqli", "tautology", "union-after-where" ]
  }
}