    { "id": "q_from",    "isStart": false, "isAccept": false },
    { "id": "q_ex",      "isStart": false, "isAccept": true  }
  ],
  "transitions": [
    { "from": "q0",        "symbol": "SELECT", "to": "q_sel"     },
    { "from": "q_sel",     "symbol": "IDENT",  "to": "q_sel"     },
    { "from": "q_sel",     "symbol": "STAR",   "to": "q_kw_from" },
    { "from": "q_sel",     "symbol": "FROM",   "to": "q_from"    },
    { "from": "q_kw_from", "symbol": "FROM",   "to": "q_from"    },
    { "from": "q_from",    "symbol": "IDENT",  "to": "q_ex"      }
